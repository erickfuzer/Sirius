<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:s="using:Sirius"
        xmlns:t="using:Sirius.Terminal"
        x:Class="Sirius.MainWindow"
        x:DataType="s:MainWindow"
        x:CompileBindings="False"
        Title="Sirius"
        Icon="avares://Sirius/Assets/sirius.ico"
        Width="1320" Height="860" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Ground}"
        Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13">

    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
        <Grid RowDefinitions="40,*">

            <!-- Barra de título -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" ColumnDefinitions="*,Auto,*"
                  PointerPressed="OnTitleBarPressed">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Path Width="15" Height="15" Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M7 0C7.6 4 9.2 6.4 14 7C9.2 7.6 7.6 10 7 14C6.4 10 4.8 7.6 0 7C4.800 6.4 6.4 4 7 0ZM17.5 15A1.5 1.5 0 1 1 14.5 15A1.5 1.5 0 1 1 17.500 15Z" />
                    <TextBlock Text="Sirius" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectName" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Classes="flat" Width="400" Height="28" CornerRadius="14"
                        Background="{DynamicResource Tint}" Click="OnOpenPalette"
                        AutomationProperties.Name="Ir para arquivo ou comando">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="11,0,4,0">
                        <Viewbox Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                            <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
                                  Data="M12 7A5 5 0 1 1 2 7A5 5 0 1 1 12 7M11 11L14.5 14.5" />
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="Ir para arquivo ou comando" FontSize="12" Foreground="{DynamicResource Muted}"
                                   Margin="8,0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{DynamicResource Sheet}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl K" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Classes="flat chrome" Click="OnMinimize" AutomationProperties.Name="Minimizar janela">
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.1" Data="M1 6H11" />
                    </Button>
                    <Button Classes="flat chrome" Click="OnMaximize" AutomationProperties.Name="Maximizar janela">
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.1" Data="M3 1.5H9A1.5 1.5 0 0 1 10.5 3V9A1.5 1.5 0 0 1 9 10.5H3A1.5 1.5 0 0 1 1.5 9V3A1.5 1.5 0 0 1 3 1.5Z" />
                    </Button>
                    <Button Classes="flat chrome" Click="OnCloseWindow" AutomationProperties.Name="Fechar janela">
                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.1" Data="M2 2L10 10M10 2L2 10" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="8,0,8,8">

                <Panel x:Name="Sidebar" Grid.Column="0" Width="232">
                    <!-- Árvore de arquivos -->
                    <Grid x:Name="TreeView" RowDefinitions="Auto,*">
                        <Grid x:Name="TreeHeader" Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Height="28" Margin="6,0,0,0">
                            <TextBlock Grid.Column="0" Text="Arquivos" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="flat" Height="24" Padding="5,0" CornerRadius="6" Click="OnOpenGit" ToolTip.Tip="Git (Ctrl Shift G)" AutomationProperties.Name="Abrir Git">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.4"
                                              Data="M5.8 3.5A1.8 1.8 0 1 1 2.2 3.5A1.8 1.8 0 1 1 5.8 3.5M5.8 12.5A1.8 1.8 0 1 1 2.2 12.5A1.8 1.8 0 1 1 5.8 12.5M13.8 5A1.8 1.8 0 1 1 10.2 5A1.8 1.8 0 1 1 13.8 5M4 5.3V10.7M12 6.8C12 9.8 4 8.3 4 10.8" />
                                    </Viewbox>
                                    <TextBlock x:Name="GitCount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" IsVisible="False" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="flat tool" Click="OnNewFile" ToolTip.Tip="Novo arquivo" AutomationProperties.Name="Novo arquivo">
                                <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.2"
                                      Data="M3 1.5H8.5L11.5 4.5V12.5H3ZM8.5 1.5V4.5H11.5M5.5 8.5H9M7.25 6.75V10.25" />
                            </Button>
                            <Button Grid.Column="2" Classes="flat tool" Click="OnNewFolder" ToolTip.Tip="Nova pasta" AutomationProperties.Name="Nova pasta">
                                <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.2"
                                      Data="M1.5 3H5.5L7 4.5H12.5V11.5H1.5ZM5.25 8H8.75M7 6.25V9.75" />
                            </Button>
                        </Grid>
                        <ScrollViewer x:Name="TreeScroll" Grid.Row="1" Background="Transparent">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Novo arquivo" Click="OnNewFileAtRoot" />
                                    <MenuItem Header="Nova pasta" Click="OnNewFolderAtRoot" />
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>
                            <ItemsControl x:Name="TreeList" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="s:TreeRow">
                                        <Button Classes="flat" Height="26" HorizontalAlignment="Stretch" Background="{Binding Background}"
                                                Foreground="{Binding Foreground}" Click="OnTreeRowClick">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Novo arquivo" Click="OnTreeNewFile" />
                                                    <MenuItem Header="Nova pasta" Click="OnTreeNewFolder" />
                                                    <Separator />
                                                    <MenuItem Header="Renomear" InputGesture="F2" Click="OnTreeRename" />
                                                    <MenuItem Header="Excluir" Click="OnTreeDelete" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{Binding Padding}">
                                                <Path Grid.Column="0" Width="12" Margin="0,0,3,0" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Data="{Binding Chevron}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding Weight}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Ellipse Grid.Column="2" Width="6" Height="6" Margin="6,0,4,0" Fill="{DynamicResource Accent}"
                                                         IsVisible="{Binding IsDirty}" />
                                                <TextBlock Grid.Column="3" Text="{Binding GitLetter}" Foreground="{Binding GitBrush}" Margin="4,0,8,0" MinWidth="8"
                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Busca no projeto -->
                    <Grid x:Name="SearchView" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" Margin="0,2,0,0">
                        <Border Grid.Row="0" Height="30" CornerRadius="15" Background="{DynamicResource Tint}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,0,4,0">
                                <TextBox x:Name="SearchInput" Grid.Column="0" Classes="bare" PlaceholderText="Buscar no projeto" FontSize="13"
                                         Foreground="{DynamicResource Ink}" AutomationProperties.Name="Buscar no projeto" />
                                <Button x:Name="MatchCaseButton" Grid.Column="1" Classes="flat option" Content="Aa" Click="OnToggleMatchCase"
                                        AutomationProperties.Name="Diferenciar maiúsculas" ToolTip.Tip="Diferenciar maiúsculas" />
                                <Button x:Name="RegexButton" Grid.Column="2" Classes="flat option" Content=".*" Click="OnToggleRegex"
                                        AutomationProperties.Name="Usar expressão regular" ToolTip.Tip="Usar expressão regular" />
                                <Button Grid.Column="3" Classes="flat option" Click="OnCloseSearch" AutomationProperties.Name="Fechar busca" ToolTip.Tip="Fechar busca">
                                    <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.1" Data="M1 1L8 8M8 1L1 8" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Height="30" Margin="0,4,0,0" CornerRadius="15" Background="{DynamicResource Tint}">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,0,4,0">
                                <TextBox x:Name="ReplaceInput" Grid.Column="0" Classes="bare" PlaceholderText="Substituir por" FontSize="13"
                                         Foreground="{DynamicResource Ink}" AutomationProperties.Name="Substituir por" />
                                <Button Grid.Column="1" Classes="flat" Height="22" CornerRadius="11" Padding="9,0" FontSize="11" FontWeight="Medium"
                                        Foreground="{DynamicResource Muted}" Content="Substituir tudo" Click="OnReplaceClick" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SearchStatus" Grid.Row="2" Margin="8,8,8,4" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="SearchList" Grid.Row="3">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:SearchRow">
                                    <Button Classes="flat" Height="24" CornerRadius="6" HorizontalAlignment="Stretch"
                                            Background="{Binding Background}" Click="OnSearchRowClick">
                                        <Panel Margin="8,0">
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsFile}">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Hint}" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="32,*" IsVisible="{Binding IsHit}">
                                                <TextBlock Grid.Column="0" Text="{Binding Line}" FontFamily="{DynamicResource CodeFont}" FontSize="11"
                                                           Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontFamily="{DynamicResource CodeFont}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run Text="{Binding Before}" Foreground="{DynamicResource Muted}" /><Run Text="{Binding Match}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" /><Run Text="{Binding After}" Foreground="{DynamicResource Muted}" /></TextBlock>
                                            </Grid>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Git -->
                    <Panel x:Name="GitView" IsVisible="False" Margin="0,2,0,0">
                        <StackPanel x:Name="GitEmptyPanel" Spacing="10" Margin="8,16" IsVisible="False">
                            <TextBlock Text="Esta pasta não usa Git" FontWeight="SemiBold" />
                            <TextBlock x:Name="GitEmptyMessage" Text="O Git guarda o histórico do projeto e permite publicar no GitHub." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                            <Button Classes="primary" Content="Iniciar repositório" Click="OnGitInitClick" />
                            <Button Classes="secondary" Content="Voltar aos arquivos" Click="OnCloseGit" />
                        </StackPanel>

                        <Grid x:Name="GitRepoPanel" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Height="28" Margin="4,0,0,0">
                                <Button x:Name="GitBranchButton" Grid.Column="0" Classes="flat" Height="24" Padding="6,0" MaxWidth="140" FontWeight="SemiBold" FontSize="12"
                                        Click="OnBranchClick" ToolTip.Tip="Trocar de branch" />
                                <Button x:Name="GitPullButton" Grid.Column="2" Classes="flat" Height="24" Padding="7,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                        Content="Receber" Click="OnPullClick" ToolTip.Tip="Receber as novidades do repositório remoto" />
                                <Button x:Name="GitPushButton" Grid.Column="3" Classes="flat" Height="24" Padding="7,0" FontSize="11" Foreground="{DynamicResource Muted}"
                                        Content="Enviar" Click="OnPushClick" ToolTip.Tip="Enviar seus commits para o repositório remoto" />
                                <Button Grid.Column="4" Classes="flat option" Click="OnCloseGit" AutomationProperties.Name="Fechar Git" ToolTip.Tip="Voltar aos arquivos">
                                    <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.1" Data="M1 1L8 8M8 1L1 8" />
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" MinHeight="54" Margin="0,4,0,0" Padding="10,6" CornerRadius="10" Background="{DynamicResource Tint}">
                                <TextBox x:Name="GitMessage" Classes="bare" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" FontSize="13"
                                         VerticalContentAlignment="Top" PlaceholderText="O que mudou? (Ctrl Enter faz o commit)" Foreground="{DynamicResource Ink}"
                                         AutomationProperties.Name="Mensagem do commit" />
                            </Border>
                            <Button Grid.Row="2" Classes="primary" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Fazer commit" Click="OnCommitClick" />
                            <TextBlock x:Name="GitStatusLine" Grid.Row="3" Margin="8,6,8,2" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="4">
                                <TextBlock x:Name="GitConflictNotice" IsVisible="False" Margin="8,2,8,6" FontSize="12" Foreground="{DynamicResource Error}" TextWrapping="Wrap"
                                           Text="Há conflitos. Edite os arquivos com !, escolha o que fica entre as marcas e faça o commit." />
                                <TextBlock x:Name="GitNothing" IsVisible="False" Margin="8,4" FontSize="12" Foreground="{DynamicResource Muted}" Text="Nenhuma mudança desde o último commit." />
                            </StackPanel>
                            <ItemsControl x:Name="GitList" Grid.Row="5" Margin="0,2,0,0">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter Name="PART_ItemsPresenter" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="s:GitRow">
                                        <Button Classes="flat" Height="26" CornerRadius="6" HorizontalAlignment="Stretch" Click="OnGitRowClick" ToolTip.Tip="Comparar com o último commit">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Comparar" Click="OnGitRowClick" />
                                                    <MenuItem Header="Abrir arquivo" Click="OnGitRowOpen" />
                                                    <Separator />
                                                    <MenuItem Header="Descartar mudanças" Click="OnGitRowDiscard" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="4,0,4,0">
                                                <Button Grid.Column="0" Classes="flat" Width="20" Height="20" CornerRadius="5" HorizontalContentAlignment="Center" Click="OnGitRowToggle"
                                                        AutomationProperties.Name="Incluir no commit" ToolTip.Tip="Incluir no commit">
                                                    <Border Width="13" Height="13" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Muted}">
                                                        <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.6" Stretch="Uniform" Margin="1" IsVisible="{Binding IsIncluded}" Data="M2 6.5L5 9.5L11 3" />
                                                    </Border>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Classes="flat" Width="20" Height="20" CornerRadius="5" HorizontalContentAlignment="Center" Click="OnGitRowDiscard"
                                                        AutomationProperties.Name="Descartar mudanças" ToolTip.Tip="Descartar mudanças">
                                                    <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.2" Data="M1 4H7A3 3 0 0 1 7 10H3M3.5 1.5L1 4L3.5 6.5" />
                                                </Button>
                                                <TextBlock Grid.Column="4" Text="{Binding Letter}" Foreground="{Binding Brush}" Margin="4,0,2,0" MinWidth="8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Panel>
                </Panel>

                <Thumb x:Name="SidebarSplitter" Grid.Column="1" Classes="splitter" DragDelta="OnSidebarDrag" DragCompleted="OnSidebarDragDone"
                       AutomationProperties.Name="Redimensionar barra lateral" />

                <!-- Folha do editor -->
                <Border x:Name="SheetBorder" Grid.Column="2" Background="{DynamicResource Sheet}" CornerRadius="12" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="34" Margin="6,2,14,0">
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TabList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="s:TabRow">
                                            <Button Classes="flat" Height="28" Foreground="{Binding Foreground}" Click="OnTabClick"
                                                    PointerPressed="OnTabPointerPressed">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,4,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" IsVisible="{Binding IsDirty}" />
                                                    <Button Classes="flat" Width="18" Height="18" Click="OnTabClose" CornerRadius="9"
                                                            HorizontalContentAlignment="Center" AutomationProperties.Name="Fechar aba">
                                                        <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.1" Data="M1 1L7 7M7 1L1 7" />
                                                    </Button>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="Breadcrumb" Grid.Column="1" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        </Grid>

                        <Panel x:Name="SheetHost" Grid.Row="1">
                            <ae:TextEditor x:Name="CodeEditor" IsVisible="False" Background="Transparent" BorderThickness="0"
                                           Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource CodeFont}" FontSize="13.5"
                                           Padding="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

                            <!-- Comparação lado a lado -->
                            <Grid x:Name="DiffHost" IsVisible="False" RowDefinitions="Auto,*" Background="{DynamicResource Sheet}">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Height="28" Margin="14,0,8,0">
                                    <TextBlock x:Name="DiffTitle" Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="flat" Height="24" Padding="8,0" FontSize="12" Foreground="{DynamicResource Muted}" Content="Abrir arquivo" Click="OnDiffOpenFile" />
                                    <Button Grid.Column="2" Classes="flat option" Click="OnCloseDiff" AutomationProperties.Name="Fechar comparação" ToolTip.Tip="Fechar (Esc)">
                                        <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.1" Data="M1 1L8 8M8 1L1 8" />
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,1,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Último commit" FontSize="11" Foreground="{DynamicResource Muted}" Margin="14,0,0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Agora" FontSize="11" Foreground="{DynamicResource Muted}" Margin="14,0,0,4" />
                                    <ae:TextEditor x:Name="DiffLeft" Grid.Row="1" Grid.Column="0" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                   Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource CodeFont}" FontSize="13.5"
                                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource Tint}" />
                                    <ae:TextEditor x:Name="DiffRight" Grid.Row="1" Grid.Column="2" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                   Foreground="{DynamicResource Ink}" FontFamily="{DynamicResource CodeFont}" FontSize="13.5"
                                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                <Button x:Name="EmptyOpenFolder" Classes="primary" Content="Abrir pasta" HorizontalAlignment="Center" Click="OnOpenFolder" />
                            </StackPanel>

                            <!-- Cápsula -->
                            <Border x:Name="Capsule" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12"
                                    Width="600" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource CapsuleBackground}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseOut" />
                                        <DoubleTransition Property="Height" Duration="0:0:0.28" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                                <Grid RowDefinitions="*,40">
                                    <Grid x:Name="TerminalArea" Grid.Row="0" RowDefinitions="Auto,*" IsVisible="False" Margin="12,8,12,0">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*">
                                            <Button x:Name="TaskTabButton" Grid.Column="0" Classes="flat terminaltab" Content="Execução" Click="OnShowTask" />
                                            <Button x:Name="ShellTabButton" Grid.Column="1" Classes="flat terminaltab" Content="Terminal" Margin="2,0,0,0" Click="OnShowShell" />
                                            <Button x:Name="ProblemsTabButton" Grid.Column="2" Classes="flat terminaltab" Content="Problemas" Margin="2,0,0,0" Click="OnShowProblems" />
                                            <TextBlock x:Name="TerminalInfo" Grid.Column="3" Margin="10,0,4,0" FontSize="12" FontFamily="{DynamicResource CodeFont}"
                                                       Foreground="{DynamicResource CapsuleMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                        <t:TerminalView x:Name="TerminalHost" Grid.Row="1" Margin="0,6,0,4"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <ScrollViewer x:Name="ProblemsScroll" Grid.Row="1" Margin="0,6,0,4" IsVisible="{Binding #ProblemsList.IsVisible}">
                                            <ItemsControl x:Name="ProblemsList" IsVisible="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="s:ProblemRow">
                                                        <Button Classes="flat terminaltab" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnProblemClick">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource CapsuleInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Location}" Margin="12,0,0,0" FontFamily="{DynamicResource CodeFont}" FontSize="11.5" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="4">
                                    <Button x:Name="RunButton" Grid.Column="0" Classes="flat run" Click="OnRunClick" Width="96"
                                            AutomationProperties.Name="Executar o projeto" ToolTip.Tip="Executar (F5)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Path x:Name="RunIcon" Fill="{DynamicResource RunInk}" VerticalAlignment="Center" Data="M1 0L9 5L1 10Z" />
                                            <Path x:Name="StopIcon" IsVisible="False" Fill="{DynamicResource RunInk}" VerticalAlignment="Center" Data="M0 0H9V9H0Z" />
                                            <TextBlock x:Name="RunLabel" Text="Executar" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BranchPanel" Grid.Column="1" Classes="flat terminaltab" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnBranchClick" ToolTip.Tip="Trocar de branch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                            <Path Stroke="{DynamicResource CapsuleMuted}" StrokeThickness="1.4"
                                                  Data="M5.8 3.5A1.8 1.8 0 1 1 2.2 3.5A1.8 1.8 0 1 1 5.8 3.5M5.8 12.5A1.8 1.8 0 1 1 2.2 12.5A1.8 1.8 0 1 1 5.8 12.5M13.8 5A1.8 1.8 0 1 1 10.2 5A1.8 1.8 0 1 1 13.8 5M4 5.3V10.7M12 6.8C12 9.8 4 8.3 4 10.8" />
                                        </Viewbox>
                                        <TextBlock x:Name="BranchName" FontSize="12" MaxWidth="110" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CapsuleMuted}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    </Button>
                                    <DockPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                        <Button x:Name="ProblemsButton" DockPanel.Dock="Left" Classes="flat terminaltab" IsVisible="False" Click="OnShowProblems" ToolTip.Tip="Ver problemas" />
                                        <Button x:Name="InstallButton" DockPanel.Dock="Left" Classes="flat terminaltab" IsVisible="False" Click="OnInstallServer" />
                                        <TextBlock x:Name="CapsuleStatus" FontSize="12" Foreground="{DynamicResource CapsuleMuted}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </DockPanel>
                                    <TextBlock x:Name="CaretPosition" Grid.Column="3" Foreground="{DynamicResource CapsuleMuted}" FontFamily="{DynamicResource CodeFont}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button x:Name="TerminalButton" Grid.Column="4" Classes="flat capsule" Click="OnToggleTerminal" AutomationProperties.Name="Abrir ou fechar o terminal" ToolTip.Tip="Terminal (Ctrl J)">
                                        <Viewbox Width="13" Height="13">
                                            <Path Stroke="{DynamicResource CapsuleInk}" StrokeThickness="1.5" Data="M2.5 4L6.5 8L2.5 12M8.5 12.5H13.5" />
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="FocusButton" Grid.Column="5" Classes="flat capsule" Click="OnToggleFocus" AutomationProperties.Name="Modo foco" ToolTip.Tip="Modo foco">
                                        <Viewbox Width="13" Height="13">
                                            <Path Stroke="{DynamicResource CapsuleInk}" StrokeThickness="1.5" Data="M2 5.5V2H5.5M10.5 2H14V5.5M14 10.5V14H10.5M5.5 14H2V10.5" />
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="6" Classes="flat capsule" Click="OnToggleTheme" AutomationProperties.Name="Trocar tema" ToolTip.Tip="Trocar tema">
                                        <Viewbox Width="13" Height="13">
                                            <Panel Width="16" Height="16">
                                                <Path Stroke="{DynamicResource CapsuleInk}" StrokeThickness="1.5" Data="M8 2A6 6 0 0 1 8 14A6 6 0 0 1 8 2Z" />
                                                <Path Fill="{DynamicResource CapsuleInk}" Data="M8 2A6 6 0 0 1 8 14Z" />
                                            </Panel>
                                        </Viewbox>
                                    </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra de comando -->
        <Panel x:Name="PaletteOverlay" IsVisible="False">
            <Border Background="{DynamicResource Veil}" PointerPressed="OnOverlayPressed" />
            <Border x:Name="PaletteCard" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,44,16,16"
                    Padding="6" CornerRadius="14" Background="{DynamicResource Pop}">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Height="38" Margin="10,0">
                        <Path Grid.Column="0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0"
                              Data="M12 7A5 5 0 1 1 2 7A5 5 0 1 1 12 7M11 11L14.5 14.5" />
                        <TextBox x:Name="PaletteInput" Grid.Column="1" Classes="bare" FontSize="15" FontWeight="Medium"
                                 PlaceholderText="O que você quer fazer?" Foreground="{DynamicResource Ink}"
                                 AutomationProperties.Name="Buscar arquivo ou comando" />
                    </Grid>
                    <ScrollViewer MaxHeight="360">
                        <ItemsControl x:Name="PaletteList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:CommandRow">
                                    <Button Classes="flat" Height="30" CornerRadius="8" HorizontalAlignment="Stretch" Background="{Binding Background}" Click="OnCommandClick">
                                        <Grid ColumnDefinitions="*,Auto" Margin="10,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Hint}" Margin="14,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="PaletteEmpty" Text="Nada encontrado." Foreground="{DynamicResource Muted}" Margin="10,8" IsVisible="False" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- Confirmação -->
        <Panel x:Name="DialogOverlay" IsVisible="False">
            <Border Background="{DynamicResource Veil}" />
            <Border x:Name="DialogCard" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                    Padding="18" CornerRadius="14" Background="{DynamicResource Pop}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="DialogTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DialogBody" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                    <Border x:Name="DialogInputBox" Height="32" Margin="0,6,0,0" Padding="10,0" CornerRadius="8" Background="{DynamicResource Tint}" IsVisible="False">
                        <TextBox x:Name="DialogInput" Classes="bare" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Nome" />
                    </Border>
                    <TextBlock x:Name="DialogError" FontSize="12" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" IsVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
                        <Button x:Name="DialogCancel" Classes="secondary" Content="Cancelar" Click="OnDialogCancel" />
                        <Button x:Name="DialogSecondary" Classes="secondary" Click="OnDialogSecondary" />
                        <Button x:Name="DialogPrimary" Classes="primary" Click="OnDialogPrimary" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
