<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:AvaloniaEdit.CodeCompletion"
             x:Class="Sirius.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <FontFamily x:Key="UiFont">avares://Sirius/Assets/Fonts#Geist</FontFamily>
        <FontFamily x:Key="CodeFont">avares://Sirius/Assets/Fonts#Geist Mono</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <!-- Divisão de um painel, como Mudanças e Histórico. -->
        <Style Selector="Button.segment">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="Button.segment.on">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- As seções das Configurações, uma embaixo da outra. -->
        <Style Selector="Button.section">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <Style Selector="Button.tool">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.capsule">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleInk}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.capsule:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CapsuleMark}" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleInk}" />
        </Style>
        <Style Selector="Button.capsule:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CapsuleMark}" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleInk}" />
        </Style>
        <Style Selector="Button.capsule.on">
            <Setter Property="Background" Value="{DynamicResource CapsuleMark}" />
        </Style>

        <Style Selector="Button.run">
            <Setter Property="Background" Value="{DynamicResource RunBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource RunInk}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.run:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RunBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource RunInk}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.run:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RunBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource RunInk}" />
        </Style>

        <Style Selector="Button.terminaltab">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleMuted}" />
        </Style>
        <Style Selector="Button.terminaltab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CapsuleMark}" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleInk}" />
        </Style>
        <Style Selector="Button.terminaltab.on">
            <Setter Property="Background" Value="{DynamicResource CapsuleMark}" />
            <Setter Property="Foreground" Value="{DynamicResource CapsuleInk}" />
        </Style>

        <Style Selector="Button.option">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.option.on">
            <Setter Property="Background" Value="{DynamicResource Sheet}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Seleção nas caixas de texto: sem isto, vinha a cor de destaque do Windows, roxa. -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Ink}" />
        </Style>

        <!-- Os botões de conflito cabem na linha do título da comparação. -->
        <Style Selector="Button.secondary.conflict">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Thumb.splitter">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border x:Name="Line" Width="2" CornerRadius="1" Margin="0,8" HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Lista de sugestões: sem isto, o destaque usa a cor de destaque do Windows, como roxo.
             Cantos pouco arredondados, como o resto da IDE. É uma janela à parte, mas o fundo dela é
             transparente: os cantos escuros só aparecem na captura por PrintWindow, não na tela. -->
        <Style Selector="cc|CompletionListBox">
            <Setter Property="Background" Value="{DynamicResource Pop}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Tint}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="cc|CompletionTipContentControl">
            <Setter Property="Background" Value="{DynamicResource Pop}" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Application.Styles>
</Application>
